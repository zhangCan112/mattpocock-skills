{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    // 干活型子 Agent：多步骤执行任务，用 GLM-5.3-Flash（快且便宜）
    "general": {
      "model": "zhipuai-coding-plan/glm-5.3-flash#max"
    }
    // explore（研究型）Agent 不设置 model，自动继承主会话的模型
  },
  // Provider 白名单：只放行 zhipu coding plan，其余 provider 全部禁用。
  // 同一文件内「最后匹配的语句生效」，所以必须先 deny 通配、再 allow 具体值；
  // 全局 policies 优先级高于项目配置，项目里无法重新启用被禁的 provider。
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "zhipuai-coding-plan", "effect": "allow" }
  ],
  // handoff-compaction 理念（v0.8.0）：六段 handoff 摘要完全替代压缩保留尾巴——
  // 不留原文 keep 段，压缩后窗口只装摘要；插件面无 keep 控制点，配置是唯一落地形态
  // buffer 不配（v0.20.0 定夺）：压缩时机由插件 smart-zone 绝对线自判——
  // 混窗口舰队（GPT 系 200k/400k + GLM 1M）下任何静态百分比都保不住同一条绝对线
  //（v0.19 曾配 "85%"，落到 200k 窗口 = 30k 就压，已撤）；宿主 buffer 吃缺省 15% 兜底。
  // 线的水位自 v0.22.0 起走全局 ~/.config/opencode/models.json（本目录 models.json，
  // 当前 180k；项目 .opencode/models.json 同键可覆盖，内置缺省 150k 兜底），插件直读，
  // 本文件不承载该键。定夺记录见 opencode-plugins-v2 docs/spec-smart-zone-auto-compact.md §18–§19、§21
  "compaction": {
    "keep": { "tokens": 0 }
  }
}
